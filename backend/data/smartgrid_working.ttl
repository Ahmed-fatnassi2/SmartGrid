@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sg: <http://www.esprit.tn/ontologies/smartgrid#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.esprit.tn/ontologies/smartgrid> a owl:Ontology ;
    rdfs:label "Ontologie Énergie et Smart Grid"@fr ;
    rdfs:comment "Production, stockage, bâtiments, lignes de transport, mobilité électrique et systèmes intelligents."@fr .

sg:Barrage_01 a sg:BarrageHydraulique,
        owl:NamedIndividual ;
    sg:actif true ;
    sg:alimente sg:Hopital_01 ;
    sg:anneeMiseService "2005"^^xsd:int ;
    sg:emissionCO2 "24.0"^^xsd:float ;
    sg:estPlusPuissantQue sg:Parc_Eolien_01 ;
    sg:injecteDans sg:Ligne_01 ;
    sg:nom "Barrage 01"^^xsd:string ;
    sg:productionAnnuelle "3500.0"^^xsd:float ;
    sg:puissance "1200"^^xsd:int ;
    sg:rendement "85.0"^^xsd:float .

sg:Borne_01 a sg:BorneRapide,
        owl:NamedIndividual ;
    sg:disponible true ;
    sg:estRaccordeeA sg:Ligne_02 ;
    sg:nom "Borne 01"^^xsd:string ;
    sg:puissanceCharge "150"^^xsd:int ;
    sg:recharge sg:Voiture_01 ;
    sg:tarifKWh "0.45"^^xsd:float ;
    sg:tempsChargeMinutes "30"^^xsd:int ;
