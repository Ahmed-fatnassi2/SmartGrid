sg:actif a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sg:SourceProduction ;
    rdfs:range xsd:boolean .

sg:adresse a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sg:Batiment ;
    rdfs:range xsd:string .

sg:alimente a owl:ObjectProperty ;
    rdfs:domain sg:SourceProduction ;
    rdfs:range sg:Batiment ;
    owl:inverseOf sg:estAlimentePar .

sg:anneeConstruction a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sg:Batiment ;
    rdfs:range xsd:int .

sg:anneeMiseService a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sg:SourceProduction ;
    rdfs:range xsd:int .

sg:anneePose a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sg:LigneTransport ;
    rdfs:range xsd:int .

sg:capacite a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Capacité en kWh"@fr ;
    rdfs:domain sg:Stockage ;
    rdfs:range xsd:float .

sg:capaciteTransport a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "MW"@fr ;
    rdfs:domain sg:LigneTransport ;
    rdfs:range xsd:float .

sg:capaciteVehicule a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "kWh"@fr ;
    rdfs:domain sg:MobiliteElectrique ;
    rdfs:range xsd:float .

sg:classeEnergetique a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sg:Batiment ;
    rdfs:range xsd:string .

sg:consommation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "kWh par an"@fr ;
    rdfs:domain sg:Batiment ;
    rdfs:range xsd:float .

sg:dateInstallation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sg:SystemeIntelligent ;
    rdfs:range xsd:date .

sg:disponible a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sg:MobiliteElectrique ;
    rdfs:range xsd:boolean .

sg:dureeVieAnnees a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sg:Stockage ;
    rdfs:range xsd:int .

sg:emissionCO2 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "g CO2 par kWh"@fr ;
    rdfs:domain sg:SourceProduction ;
    rdfs:range xsd:float .

sg:estConnecteA a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:domain sg:LigneTransport ;
    rdfs:range sg:LigneTransport .

sg:estPlusPuissantQue a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain sg:SourceProduction ;
    rdfs:range sg:SourceProduction .

sg:estRaccordeeA a owl:ObjectProperty ;
    rdfs:domain sg:BorneRecharge ;
    rdfs:range sg:LigneTransport .

sg:etatLigne a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sg:LigneTransport ;
    rdfs:range xsd:string .

sg:frequenceMesure a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "secondes"@fr ;
    rdfs:domain sg:SystemeIntelligent ;
    rdfs:range xsd:int .

sg:gere a owl:ObjectProperty ;
    rdfs:domain sg:PlateformeGestion ;
    rdfs:range sg:Stockage .

sg:injecteDans a owl:ObjectProperty ;
    rdfs:domain sg:SourceProduction ;
    rdfs:range sg:LigneTransport ;
    owl:inverseOf sg:recoitDe .

sg:longueur a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "km"@fr ;
    rdfs:domain sg:LigneTransport ;
    rdfs:range xsd:float .

sg:mesure a owl:ObjectProperty ;
    rdfs:domain sg:CompteurIntelligent ;
    rdfs:range sg:Batiment ;
    owl:inverseOf sg:estMesurePar .

sg:nbOccupants a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sg:Batiment ;
    rdfs:range xsd:int .

sg:nom a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:string .

sg:pertes a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "%"@fr ;
    rdfs:domain sg:LigneTransport ;
    rdfs:range xsd:float .

sg:precisionMesure a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "%"@fr ;
    rdfs:domain sg:SystemeIntelligent ;
    rdfs:range xsd:float .

sg:predit a owl:ObjectProperty ;
    rdfs:domain sg:ModelePrediction ;
    rdfs:range sg:SourceProduction .

sg:productionAnnuelle a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "MWh par an"@fr ;
    rdfs:domain sg:SourceProduction ;
    rdfs:range xsd:float .

sg:protocole a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sg:SystemeIntelligent ;
    rdfs:range xsd:string .

sg:puissance a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Puissance installée en kW"@fr ;
    rdfs:domain sg:SourceProduction ;
    rdfs:range xsd:int .

sg:puissanceCharge a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "kW"@fr ;
    rdfs:domain sg:MobiliteElectrique ;
    rdfs:range xsd:int .

sg:puissanceStockage a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "kW"@fr ;
    rdfs:domain sg:Stockage ;
    rdfs:range xsd:int .

sg:recharge a owl:ObjectProperty ;
    rdfs:domain sg:BorneRecharge ;
    rdfs:range sg:VehiculeElectrique ;
    owl:inverseOf sg:estRechargePar .

sg:rendement a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Rendement en %"@fr ;
    rdfs:domain sg:SourceProduction ;
    rdfs:range xsd:float .

sg:rendementStockage a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "%"@fr ;
    rdfs:domain sg:Stockage ;
    rdfs:range xsd:float .

sg:restitueA a owl:ObjectProperty ;
    rdfs:domain sg:VehiculeElectrique ;
    rdfs:range sg:LigneTransport .

sg:stocke a owl:ObjectProperty ;
    rdfs:domain sg:Stockage ;
    rdfs:range sg:SourceProduction ;
    owl:inverseOf sg:estStockePar .

sg:surface a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "m2"@fr ;
    rdfs:domain sg:Batiment ;
    rdfs:range xsd:float .

sg:surveille a owl:ObjectProperty ;
    rdfs:domain sg:CapteurIoT ;
    rdfs:range sg:LigneTransport .

sg:tarifKWh a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sg:MobiliteElectrique ;
    rdfs:range xsd:float .

sg:tauxCharge a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Taux de charge en %"@fr ;
    rdfs:domain sg:Stockage ;
    rdfs:range xsd:float .

sg:tempsChargeMinutes a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sg:MobiliteElectrique ;
    rdfs:range xsd:int .

sg:tempsRechargeHeures a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sg:Stockage ;
    rdfs:range xsd:float .

sg:tension a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "kV"@fr ;
    rdfs:domain sg:LigneTransport ;
    rdfs:range xsd:float .

sg:typeConnecteur a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sg:MobiliteElectrique ;
    rdfs:range xsd:string .

sg:valeurMesuree a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sg:SystemeIntelligent ;
    rdfs:range xsd:float .

sg:versionLogiciel a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sg:SystemeIntelligent ;
    rdfs:range xsd:string .

sg:AlertePanne a owl:Class ;
